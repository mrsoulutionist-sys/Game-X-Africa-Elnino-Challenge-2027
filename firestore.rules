rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidFarmerKey(key) {
      return key is string && key.size() == 64 && key.matches('^[a-f0-9]{64}$');
    }

    function isValidDocId(id) {
      return id is string && id.size() >= 2 && id.size() <= 120 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTierList(tiers) {
      return tiers is list
        && tiers.size() <= 6
        && (
          tiers.size() == 0
          || (
            tiers[0] is map
            && tiers[0].keys().hasOnly([
              'tierIndex',
              'pipeInstalled',
              'cropId',
              'plantedAtMs',
              'wateredAtMs',
              'waterDurationHours',
              'harvested'
            ])
          )
        );
    }

    function isValidGrade(g) {
      return g in [
        'Grade 4',
        'Grade 5',
        'Grade 6',
        'Grade 7',
        'Grade 8',
        'Grade 9',
        'Grade 10',
        'Grade 11',
        'Grade 12'
      ];
    }

    function isValidOptionalResilienceFields(data) {
      return (!('jojoInstalled' in data) || data.jojoInstalled is bool)
        && (!('jojoLitres' in data) || (data.jojoLitres is number && data.jojoLitres >= 0 && data.jojoLitres <= 500))
        && (!('jojoCapacity' in data) || (data.jojoCapacity is number && data.jojoCapacity >= 20 && data.jojoCapacity <= 500))
        && (!('shadeClothInstalled' in data) || data.shadeClothInstalled is bool)
        && (!('weatherMode' in data) || data.weatherMode in ['normal', 'elnino_watch', 'heatwave'])
        && (!('litresSaved' in data) || (data.litresSaved is number && data.litresSaved >= 0 && data.litresSaved <= 1000000))
        && (!('foodServings' in data) || (data.foodServings is int && data.foodServings >= 0 && data.foodServings <= 1000000))
        && (!('door3DripBottleType' in data) || data.door3DripBottleType == null || data.door3DripBottleType in ['clear_soda', 'green_sparkling', 'clear_water'])
        && (!('door3DripStep' in data) || (data.door3DripStep is int && data.door3DripStep >= 0 && data.door3DripStep <= 4))
        && (!('door3CompostContainer' in data) || data.door3CompostContainer == null || data.door3CompostContainer in ['bucket', 'crate', 'pallet'])
        && (!('door3CompostStep' in data) || (data.door3CompostStep is int && data.door3CompostStep >= 0 && data.door3CompostStep <= 6))
        && (!('door3CompostRejectTested' in data) || (data.door3CompostRejectTested is int && data.door3CompostRejectTested >= 0 && data.door3CompostRejectTested <= 4))
        && (!('door3MulchMaterial' in data) || data.door3MulchMaterial == null || data.door3MulchMaterial in ['cardboard', 'newspaper'])
        && (!('door3MulchStep' in data) || (data.door3MulchStep is int && data.door3MulchStep >= 0 && data.door3MulchStep <= 4))
        && (!('compostYieldsSinceRefresh' in data) || (data.compostYieldsSinceRefresh is int && data.compostYieldsSinceRefresh >= 0 && data.compostYieldsSinceRefresh <= 50))
        && (!('compostCycleCount' in data) || (data.compostCycleCount is int && data.compostCycleCount >= 0 && data.compostCycleCount <= 10000))
        && (!('bestCompetitionMs' in data) || data.bestCompetitionMs == null || (data.bestCompetitionMs is int && data.bestCompetitionMs >= 0 && data.bestCompetitionMs <= 86400000));
    }

    function isValidStudentMetaFields(data) {
      return (!('role' in data) || data.role == 'student')
        && (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 100))
        && (!('schoolKey' in data) || (data.schoolKey is string && data.schoolKey.size() >= 1 && data.schoolKey.size() <= 100))
        && (!('grade' in data) || isValidGrade(data.grade))
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 60));
    }

    function isValidFarmerDoc(data, pathKey) {
      return data.keys().hasAll([
          'farmerKey',
          'farmerName',
          'activeZone',
          'kitchenStep',
          'rackSize',
          'tiers',
          'totalHarvestedCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'farmerKey',
          'farmerName',
          'activeZone',
          'kitchenStep',
          'rackSize',
          'tiers',
          'totalHarvestedCount',
          'jojoInstalled',
          'jojoLitres',
          'jojoCapacity',
          'shadeClothInstalled',
          'weatherMode',
          'litresSaved',
          'foodServings',
          'door3DripBottleType',
          'door3DripStep',
          'door3CompostContainer',
          'door3CompostStep',
          'door3CompostRejectTested',
          'door3MulchMaterial',
          'door3MulchStep',
          'compostYieldsSinceRefresh',
          'compostCycleCount',
          'bestCompetitionMs',
          'role',
          'schoolName',
          'schoolKey',
          'grade',
          'teacherName',
          'createdAt',
          'updatedAt'
        ])
        && data.farmerKey is string
        && data.farmerKey == pathKey
        && data.farmerName is string
        && data.farmerName.size() >= 1
        && data.farmerName.size() <= 40
        && data.activeZone in ['kitchen', 'garden', 'compost']
        && data.kitchenStep is string
        && data.kitchenStep.size() >= 3
        && data.kitchenStep.size() <= 40
        && data.rackSize is int
        && data.rackSize >= 2
        && data.rackSize <= 6
        && isValidTierList(data.tiers)
        && data.totalHarvestedCount is int
        && data.totalHarvestedCount >= 0
        && data.totalHarvestedCount <= 100000
        && isValidOptionalResilienceFields(data)
        && isValidStudentMetaFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParentGrades(grades) {
      return grades is list
        && grades.size() >= 1
        && grades.size() <= 9
        && grades[0] is string
        && grades.hasOnly([
          'Grade 4',
          'Grade 5',
          'Grade 6',
          'Grade 7',
          'Grade 8',
          'Grade 9',
          'Grade 10',
          'Grade 11',
          'Grade 12'
        ]);
    }

    function isValidAdoptedPet(pet) {
      return pet is map
        && pet.keys().hasAll(['id', 'species', 'name', 'age', 'adoptedAt', 'happiness', 'hunger'])
        && pet.keys().hasOnly([
          'id',
          'species',
          'name',
          'age',
          'adoptedAt',
          'happiness',
          'hunger',
          'water',
          'energy',
          'play',
          'supplyDaysRemaining',
          'supplyUntilMs',
          'lastCareAtMs'
        ])
        && pet.id in ['thabo-tortoise', 'zuri-rabbit', 'kudu-grysbok', 'biko-dassie']
        && pet.species is string
        && pet.species.size() >= 2
        && pet.species.size() <= 40
        && pet.name is string
        && pet.name.size() >= 1
        && pet.name.size() <= 30
        && pet.age is int
        && pet.age >= 1
        && pet.age <= 50
        && pet.adoptedAt is string
        && pet.adoptedAt.size() >= 10
        && pet.adoptedAt.size() <= 40
        && pet.happiness is int
        && pet.happiness >= 0
        && pet.happiness <= 100
        && pet.hunger is int
        && pet.hunger >= 0
        && pet.hunger <= 100
        && (!('water' in pet) || (pet.water is int && pet.water >= 0 && pet.water <= 100))
        && (!('energy' in pet) || (pet.energy is int && pet.energy >= 0 && pet.energy <= 100))
        && (!('play' in pet) || (pet.play is int && pet.play >= 0 && pet.play <= 100))
        && (!('supplyDaysRemaining' in pet) || (pet.supplyDaysRemaining is int && pet.supplyDaysRemaining >= 0 && pet.supplyDaysRemaining <= 30))
        && (!('supplyUntilMs' in pet) || (pet.supplyUntilMs is int && pet.supplyUntilMs >= 0))
        && (!('lastCareAtMs' in pet) || (pet.lastCareAtMs is int && pet.lastCareAtMs >= 0));
    }

    function isValidAdoptedPetsList(pets) {
      return pets is list
        && pets.size() <= 4
        && (pets.size() == 0 || isValidAdoptedPet(pets[0]));
    }

    function isValidParentDoc(data, pathKey) {
      return data.keys().hasAll([
          'parentKey',
          'role',
          'pseudonym',
          'schoolName',
          'schoolKey',
          'grades',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'parentKey',
          'role',
          'pseudonym',
          'schoolName',
          'schoolKey',
          'grades',
          'adoptedPets',
          'walletBalanceZar',
          'createdAt',
          'updatedAt'
        ])
        && data.parentKey is string
        && data.parentKey == pathKey
        && data.role in ['parent', 'sponsor', 'teacher', 'family']
        && data.pseudonym is string
        && data.pseudonym.size() >= 1
        && data.pseudonym.size() <= 40
        && data.schoolName is string
        && data.schoolName.size() >= 1
        && data.schoolName.size() <= 100
        && data.schoolKey is string
        && data.schoolKey.size() >= 1
        && data.schoolKey.size() <= 100
        && isValidParentGrades(data.grades)
        && (!('adoptedPets' in data) || isValidAdoptedPetsList(data.adoptedPets))
        && (!('walletBalanceZar' in data) || (data.walletBalanceZar is number && data.walletBalanceZar >= 0 && data.walletBalanceZar <= 1000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOwnedPetIdList(ids) {
      return ids is list
        && ids.size() <= 4
        && (
          ids.size() == 0
          || (
            ids[0] is string
            && ids.hasOnly(['thabo-tortoise', 'zuri-rabbit', 'kudu-grysbok', 'biko-dassie'])
          )
        );
    }

    function isValidUserDoc(data, pathUid) {
      return data.keys().hasAll([
          'uid',
          'name',
          'role',
          'schoolId',
          'schoolName',
          'grade',
          'walletBalanceZar',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'role',
          'schoolId',
          'schoolName',
          'grade',
          'grades',
          'walletBalanceZar',
          'ownedPetIds',
          'adoptedPets',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == pathUid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.role in ['student', 'parent', 'sponsor', 'teacher', 'family']
        && data.schoolId is string
        && data.schoolId.size() <= 100
        && data.schoolName is string
        && data.schoolName.size() <= 100
        && data.grade is string
        && data.grade.size() >= 1
        && data.grade.size() <= 120
        && (!('grades' in data) || isValidParentGrades(data.grades))
        && data.walletBalanceZar is number
        && data.walletBalanceZar >= 0
        && data.walletBalanceZar <= 1000000
        && (!('ownedPetIds' in data) || isValidOwnedPetIdList(data.ownedPetIds))
        && (!('adoptedPets' in data) || isValidAdoptedPetsList(data.adoptedPets))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPetCareEffect(effect) {
      return effect is map
        && effect.keys().hasAll(['stat', 'boostAmount'])
        && effect.keys().hasOnly(['stat', 'boostAmount', 'supplyDays'])
        && effect.stat in ['hunger', 'water', 'energy', 'play']
        && effect.boostAmount is int
        && effect.boostAmount >= 1
        && effect.boostAmount <= 100
        && (!('supplyDays' in effect) || (effect.supplyDays is int && effect.supplyDays >= 1 && effect.supplyDays <= 30));
    }

    function isValidStoreListingDoc(data, pathId) {
      return data.keys().hasAll([
          'listingId',
          'title',
          'category',
          'sourceType',
          'quantityAvailable',
          'priceZar',
          'schoolId',
          'schoolName',
          'grade',
          'petCareEffect',
          'updatedAt',
          'status'
        ])
        && data.keys().hasOnly([
          'listingId',
          'title',
          'category',
          'sourceType',
          'quantityAvailable',
          'priceZar',
          'schoolId',
          'schoolName',
          'grade',
          'studentUid',
          'studentName',
          'petCareEffect',
          'lastHarvestedAt',
          'updatedAt',
          'status'
        ])
        && data.listingId is string
        && data.listingId == pathId
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 100
        && data.category in ['harvest_produce', 'mulch_compost', 'pet_care']
        && data.sourceType in ['student_harvest', 'care_bundle']
        && data.quantityAvailable is int
        && data.quantityAvailable >= 0
        && data.quantityAvailable <= 10000
        && data.priceZar is number
        && data.priceZar >= 1
        && data.priceZar <= 5000
        && data.schoolId is string
        && data.schoolId.size() <= 100
        && data.schoolName is string
        && data.schoolName.size() <= 100
        && data.grade is string
        && data.grade.size() <= 40
        && (!('studentUid' in data) || (data.studentUid is string && data.studentUid.size() <= 64))
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 40))
        && isValidPetCareEffect(data.petCareEffect)
        && (!('lastHarvestedAt' in data) || data.lastHarvestedAt == null || data.lastHarvestedAt is timestamp)
        && data.updatedAt is timestamp
        && data.status in ['active', 'sold_out'];
    }

    function isValidStudentGrowDoc(data, pathId) {
      return data.keys().hasAll([
          'growId',
          'studentUid',
          'studentName',
          'schoolId',
          'schoolName',
          'grade',
          'cropId',
          'itemTitle',
          'category',
          'plantedAtMs',
          'harvestReadyAtMs',
          'harvested',
          'expectedYieldQty',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'growId',
          'studentUid',
          'studentName',
          'schoolId',
          'schoolName',
          'grade',
          'cropId',
          'itemTitle',
          'category',
          'plantedAtMs',
          'harvestReadyAtMs',
          'harvested',
          'expectedYieldQty',
          'updatedAt'
        ])
        && data.growId is string
        && data.growId == pathId
        && isValidFarmerKey(data.studentUid)
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 40
        && data.schoolId is string
        && data.schoolId.size() <= 100
        && data.schoolName is string
        && data.schoolName.size() <= 100
        && data.grade is string
        && data.grade.size() <= 40
        && data.cropId is string
        && data.cropId.size() >= 1
        && data.cropId.size() <= 40
        && data.itemTitle is string
        && data.itemTitle.size() >= 2
        && data.itemTitle.size() <= 100
        && data.category in ['harvest_produce', 'mulch_compost']
        && data.plantedAtMs is int
        && data.plantedAtMs >= 0
        && data.harvestReadyAtMs is int
        && data.harvestReadyAtMs >= 0
        && data.harvested is bool
        && data.expectedYieldQty is int
        && data.expectedYieldQty >= 1
        && data.expectedYieldQty <= 50
        && data.updatedAt is timestamp;
    }

    function isValidHarvestBatchDoc(data, pathId) {
      return data.keys().hasAll([
          'batchId',
          'studentUid',
          'studentName',
          'schoolId',
          'schoolName',
          'grade',
          'itemTitle',
          'category',
          'quantity',
          'harvestedAt',
          'harvestedAtMs'
        ])
        && data.keys().hasOnly([
          'batchId',
          'studentUid',
          'studentName',
          'schoolId',
          'schoolName',
          'grade',
          'itemTitle',
          'category',
          'quantity',
          'harvestedAt',
          'harvestedAtMs'
        ])
        && data.batchId is string
        && data.batchId == pathId
        && isValidFarmerKey(data.studentUid)
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 40
        && data.schoolId is string
        && data.schoolId.size() <= 100
        && data.schoolName is string
        && data.schoolName.size() <= 100
        && data.grade is string
        && data.grade.size() <= 40
        && data.itemTitle is string
        && data.itemTitle.size() >= 2
        && data.itemTitle.size() <= 100
        && data.category in ['harvest_produce', 'mulch_compost']
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 100
        && data.harvestedAt is timestamp
        && data.harvestedAtMs is int
        && data.harvestedAtMs >= 0;
    }

    function isValidOrderItemsList(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 20
        && items[0] is map
        && items[0].keys().hasAll(['listingId', 'title', 'quantity', 'priceZar', 'petCareEffect'])
        && items[0].keys().hasOnly([
          'listingId',
          'title',
          'quantity',
          'priceZar',
          'sourceSchoolId',
          'sourceGrade',
          'studentName',
          'petCareEffect'
        ]);
    }

    function isValidStoreOrderDoc(data, pathId) {
      return data.keys().hasAll([
          'orderId',
          'buyerUid',
          'buyerName',
          'items',
          'totalPaidZar',
          'walletBeforeZar',
          'walletAfterZar',
          'targetPetId',
          'targetPetName',
          'paymentChannel',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'orderId',
          'buyerUid',
          'buyerName',
          'items',
          'totalPaidZar',
          'walletBeforeZar',
          'walletAfterZar',
          'targetPetId',
          'targetPetName',
          'paymentChannel',
          'createdAt'
        ])
        && data.orderId is string
        && data.orderId == pathId
        && isValidFarmerKey(data.buyerUid)
        && data.buyerName is string
        && data.buyerName.size() >= 1
        && data.buyerName.size() <= 40
        && isValidOrderItemsList(data.items)
        && data.totalPaidZar is number
        && data.totalPaidZar > 0
        && data.totalPaidZar <= 100000
        && data.walletBeforeZar is number
        && data.walletBeforeZar >= data.totalPaidZar
        && data.walletAfterZar is number
        && data.walletAfterZar >= 0
        && data.targetPetId is string
        && data.targetPetId.size() <= 40
        && data.targetPetName is string
        && data.targetPetName.size() <= 40
        && data.paymentChannel == 'Karri Credit Wallet'
        && data.createdAt is timestamp;
    }

    function isValidWalletTopupDoc(data, pathId) {
      return data.keys().hasAll([
          'topupId',
          'userId',
          'amountZar',
          'provider',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'topupId',
          'userId',
          'amountZar',
          'provider',
          'status',
          'createdAt'
        ])
        && data.topupId is string
        && data.topupId == pathId
        && isValidFarmerKey(data.userId)
        && data.amountZar is number
        && data.amountZar >= 250
        && data.amountZar <= 100000
        && data.provider == 'Karri'
        && data.status == 'completed'
        && data.createdAt is timestamp;
    }

    function isValidAdminMetaDoc(data) {
      return data.keys().hasAll(['docId', 'claimed', 'primaryAdminName', 'claimedAt'])
        && data.keys().hasOnly(['docId', 'claimed', 'primaryAdminName', 'claimedAt'])
        && data.docId == 'status'
        && data.claimed == true
        && data.primaryAdminName is string
        && data.primaryAdminName.size() >= 1
        && data.primaryAdminName.size() <= 40
        && data.claimedAt is timestamp;
    }

    function isValidAdminAccountDoc(data, pathKey) {
      return data.keys().hasAll(['adminKey', 'adminName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['adminKey', 'adminName', 'role', 'createdAt', 'updatedAt'])
        && data.adminKey is string
        && data.adminKey == pathKey
        && data.adminName is string
        && data.adminName.size() >= 1
        && data.adminName.size() <= 40
        && data.role == 'admin'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminWriteTokenDoc(data, pathId) {
      return data.keys().hasAll(['tokenId', 'adminKey', 'createdAt'])
        && data.keys().hasOnly(['tokenId', 'adminKey', 'createdAt'])
        && data.tokenId is string
        && data.tokenId == pathId
        && isValidFarmerKey(data.adminKey)
        && data.createdAt is timestamp;
    }

    function hasFreshAdminWriteToken(tokenId) {
      return isValidDocId(tokenId)
        && existsAfter(/databases/$(database)/documents/admin_write_tokens/$(tokenId))
        && getAfter(/databases/$(database)/documents/admin_write_tokens/$(tokenId)).data.createdAt == request.time;
    }

    function isValidBannerEntry(b) {
      return b is map
        && b.keys().hasAll(['id', 'text', 'style', 'stage', 'active'])
        && b.keys().hasOnly(['id', 'text', 'style', 'stage', 'active'])
        && b.id is string
        && b.id.size() >= 1
        && b.id.size() <= 64
        && b.text is string
        && b.text.size() >= 2
        && b.text.size() <= 180
        && b.style in ['scroll', 'flash']
        && b.stage in ['all', 'kitchen', 'garden', 'compost', 'harvest_ready', 'compost_needed']
        && b.active is bool;
    }

    function isValidBannerList(banners) {
      return banners is list
        && banners.size() <= 12
        && (banners.size() == 0 || isValidBannerEntry(banners[0]));
    }

    function isValidSystemConfigDoc(data, pathId) {
      return data.keys().hasAll([
          'configId',
          'competitionTimerEnabled',
          'compostYieldCycleLimit',
          'challengeBannerText',
          'actionTokenId',
          'updatedByAdminName',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'configId',
          'competitionTimerEnabled',
          'compostYieldCycleLimit',
          'challengeBannerText',
          'banners',
          'actionTokenId',
          'updatedByAdminName',
          'updatedAt'
        ])
        && data.configId == pathId
        && data.competitionTimerEnabled is bool
        && data.compostYieldCycleLimit is int
        && data.compostYieldCycleLimit >= 1
        && data.compostYieldCycleLimit <= 10
        && data.challengeBannerText is string
        && data.challengeBannerText.size() <= 180
        && (!('banners' in data) || isValidBannerList(data.banners))
        && isValidDocId(data.actionTokenId)
        && data.updatedByAdminName is string
        && data.updatedByAdminName.size() >= 1
        && data.updatedByAdminName.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidAdminDocumentDoc(data, pathId) {
      return data.keys().hasAll([
          'docId',
          'title',
          'description',
          'category',
          'fileName',
          'mimeType',
          'sizeBytes',
          'contentBase64',
          'active',
          'actionTokenId',
          'uploadedByAdminName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'docId',
          'title',
          'description',
          'category',
          'fileName',
          'mimeType',
          'sizeBytes',
          'contentBase64',
          'active',
          'actionTokenId',
          'uploadedByAdminName',
          'createdAt',
          'updatedAt'
        ])
        && data.docId is string
        && data.docId == pathId
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 300
        && data.category in ['guide', 'rules', 'curriculum', 'notice']
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 120
        && data.mimeType is string
        && data.mimeType.size() >= 3
        && data.mimeType.size() <= 80
        && data.sizeBytes is int
        && data.sizeBytes >= 1
        && data.sizeBytes <= 450000
        && data.contentBase64 is string
        && data.contentBase64.size() >= 1
        && data.contentBase64.size() <= 620000
        && data.active is bool
        && isValidDocId(data.actionTokenId)
        && data.uploadedByAdminName is string
        && data.uploadedByAdminName.size() >= 1
        && data.uploadedByAdminName.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompetitionRunDoc(data, pathId) {
      return data.keys().hasAll([
          'runId',
          'farmerKey',
          'farmerName',
          'schoolId',
          'grade',
          'elapsedMs',
          'compostCycleCount',
          'milestoneLabel',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'runId',
          'farmerKey',
          'farmerName',
          'schoolId',
          'grade',
          'elapsedMs',
          'compostCycleCount',
          'milestoneLabel',
          'createdAt'
        ])
        && data.runId is string
        && data.runId == pathId
        && isValidFarmerKey(data.farmerKey)
        && data.farmerName is string
        && data.farmerName.size() >= 1
        && data.farmerName.size() <= 40
        && data.schoolId is string
        && data.schoolId.size() <= 100
        && data.grade is string
        && data.grade.size() <= 40
        && data.elapsedMs is int
        && data.elapsedMs >= 500
        && data.elapsedMs <= 86400000
        && data.compostCycleCount is int
        && data.compostCycleCount >= 0
        && data.compostCycleCount <= 10000
        && data.milestoneLabel is string
        && data.milestoneLabel.size() >= 2
        && data.milestoneLabel.size() <= 80
        && data.createdAt is timestamp;
    }

    // Connection probe document (single get only, no list or writes)
    match /test/connection {
      allow get: if request.time != null;
      allow list, write: if false;
    }

    // Farmer profiles keyed by SHA-256(farmerName + passcode)
    match /farmers/{farmerKey} {
      allow get: if isValidFarmerKey(farmerKey);
      allow list: if false;
      allow create: if isValidFarmerKey(farmerKey)
        && isValidFarmerDoc(incoming(), farmerKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidFarmerKey(farmerKey)
        && isValidFarmerDoc(incoming(), farmerKey)
        && incoming().farmerKey == existing().farmerKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'farmerName',
          'activeZone',
          'kitchenStep',
          'rackSize',
          'tiers',
          'totalHarvestedCount',
          'jojoInstalled',
          'jojoLitres',
          'jojoCapacity',
          'shadeClothInstalled',
          'weatherMode',
          'litresSaved',
          'foodServings',
          'door3DripBottleType',
          'door3DripStep',
          'door3CompostContainer',
          'door3CompostStep',
          'door3CompostRejectTested',
          'door3MulchMaterial',
          'door3MulchStep',
          'compostYieldsSinceRefresh',
          'compostCycleCount',
          'bestCompetitionMs',
          'role',
          'schoolName',
          'schoolKey',
          'grade',
          'teacherName',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Parent / Sponsor / Teacher / Family profiles keyed by SHA-256(pseudonym + passcode)
    match /parents/{parentKey} {
      allow get: if isValidFarmerKey(parentKey);
      allow list: if false;
      allow create: if isValidFarmerKey(parentKey)
        && isValidParentDoc(incoming(), parentKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidFarmerKey(parentKey)
        && isValidParentDoc(incoming(), parentKey)
        && incoming().parentKey == existing().parentKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'role',
          'pseudonym',
          'schoolName',
          'schoolKey',
          'grades',
          'adoptedPets',
          'walletBalanceZar',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Standardized unified users/{uid} collection
    match /users/{uid} {
      allow get: if isValidFarmerKey(uid);
      allow list: if false;
      allow create: if isValidFarmerKey(uid)
        && isValidUserDoc(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidFarmerKey(uid)
        && isValidUserDoc(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'role',
          'schoolId',
          'schoolName',
          'grade',
          'grades',
          'walletBalanceZar',
          'ownedPetIds',
          'adoptedPets',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Storefront inventory listings (public/school shelf read, validated writes)
    match /store_listings/{listingId} {
      allow get, list: if request.time != null;
      allow create: if isValidDocId(listingId)
        && isValidStoreListingDoc(incoming(), listingId)
        && incoming().updatedAt == request.time;
      allow update: if isValidDocId(listingId)
        && isValidStoreListingDoc(incoming(), listingId)
        && incoming().listingId == existing().listingId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'category',
          'sourceType',
          'quantityAvailable',
          'priceZar',
          'schoolId',
          'schoolName',
          'grade',
          'studentUid',
          'studentName',
          'petCareEffect',
          'lastHarvestedAt',
          'updatedAt',
          'status'
        ]);
      allow delete: if false;
    }

    // Active growing student crops & Door 3 cycles ("On Its Way" visibility)
    match /student_grows/{growId} {
      allow get, list: if request.time != null;
      allow create: if isValidDocId(growId)
        && isValidStudentGrowDoc(incoming(), growId)
        && incoming().updatedAt == request.time;
      allow update: if isValidDocId(growId)
        && isValidStudentGrowDoc(incoming(), growId)
        && incoming().growId == existing().growId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'studentName',
          'schoolId',
          'schoolName',
          'grade',
          'cropId',
          'itemTitle',
          'category',
          'plantedAtMs',
          'harvestReadyAtMs',
          'harvested',
          'expectedYieldQty',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Student harvest batches (append-only for 14-day score & shelf freshness)
    match /harvest_batches/{batchId} {
      allow get, list: if request.time != null;
      allow create: if isValidDocId(batchId)
        && isValidHarvestBatchDoc(incoming(), batchId)
        && incoming().harvestedAt == request.time;
      allow update, delete: if false;
    }

    // Completed Karri Credit Wallet store orders (scoped by buyerUid on list)
    match /store_orders/{orderId} {
      allow get: if isValidDocId(orderId);
      allow list: if resource.data.buyerUid is string && resource.data.buyerUid.size() == 64;
      allow create: if isValidDocId(orderId)
        && isValidStoreOrderDoc(incoming(), orderId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Minimum R250 Karri wallet top-up records (scoped by userId on list)
    match /wallet_topups/{topupId} {
      allow get: if isValidDocId(topupId);
      allow list: if resource.data.userId is string && resource.data.userId.size() == 64;
      allow create: if isValidDocId(topupId)
        && isValidWalletTopupDoc(incoming(), topupId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Singleton bootstrap status doc for Admin account claiming
    match /admin_meta/{docId} {
      allow get: if docId == 'status' && request.time != null;
      allow list: if false;
      allow create: if docId == 'status'
        && isValidAdminMetaDoc(incoming())
        && incoming().claimedAt == request.time
        && !exists(/databases/$(database)/documents/admin_meta/status);
      allow update, delete: if false;
    }

    // Private Admin records keyed by SHA-256(adminName + passcode)
    match /admins/{adminKey} {
      allow get: if isValidFarmerKey(adminKey);
      allow list: if false;
      allow create: if isValidFarmerKey(adminKey)
        && isValidAdminAccountDoc(incoming(), adminKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/admin_meta/status);
      allow update: if isValidFarmerKey(adminKey)
        && isValidAdminAccountDoc(incoming(), adminKey)
        && incoming().adminKey == existing().adminKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['adminName', 'updatedAt']);
      allow delete: if false;
    }

    // Write-only atomic Admin action tokens (prevents adminKey exposure on public reads)
    match /admin_write_tokens/{tokenId} {
      allow read: if false;
      allow create: if isValidDocId(tokenId)
        && isValidAdminWriteTokenDoc(incoming(), tokenId)
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/admins/$(incoming().adminKey));
      allow update, delete: if false;
    }

    // Admin-controlled global settings (Competition Timer & Compost Redo Yield Limit)
    match /system_config/{configId} {
      allow get: if configId == 'global' && request.time != null;
      allow list: if false;
      allow create, update: if configId == 'global'
        && isValidSystemConfigDoc(incoming(), configId)
        && incoming().updatedAt == request.time
        && hasFreshAdminWriteToken(incoming().actionTokenId);
      allow delete: if false;
    }

    // Admin-uploaded documents & curriculum guides
    match /admin_documents/{docId} {
      allow get, list: if request.time != null;
      allow create: if isValidDocId(docId)
        && isValidAdminDocumentDoc(incoming(), docId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasFreshAdminWriteToken(incoming().actionTokenId);
      allow update: if isValidDocId(docId)
        && isValidAdminDocumentDoc(incoming(), docId)
        && incoming().docId == existing().docId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'description',
          'category',
          'active',
          'actionTokenId',
          'uploadedByAdminName',
          'updatedAt'
        ])
        && hasFreshAdminWriteToken(incoming().actionTokenId);
      allow delete: if false;
    }

    // Competition speed-run leaderboard records
    match /competition_runs/{runId} {
      allow get, list: if request.time != null;
      allow create: if isValidDocId(runId)
        && isValidCompetitionRunDoc(incoming(), runId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
